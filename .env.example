# Golf Score Tracker — Supabase config (optional)
# Copy this file to .env.local and fill in your Supabase project details.
# The app works fully offline without these variables.
# Add them only if you want live multi-device sync.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# After adding these:
# 1. Run the SQL in supabase/schema.sql in your Supabase SQL editor
# 2. Restart the dev server: npm run dev
